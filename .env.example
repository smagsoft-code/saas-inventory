# -----------------------------------------------------------------------------
# Environment variables template.
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# -----------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Same value as API_URL, exposed to the browser bundle — Next.js only inlines NEXT_PUBLIC_*
# variables into client-side code, so Client Components (login/register forms, apps/web/src/lib/
# api-client.ts) need this distinct var; Server Components use API_URL directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database ---
# PostgreSQL connection strings used by the API only.
# The web/mobile apps never receive or use these variables.
#
# DATABASE_URL authenticates as the app_tenant role — subject to Row-Level Security, used for
# all normal request handling (see docs/architecture/database.md#row-level-security).
DATABASE_URL=postgresql://app_tenant:password@localhost:5432/saas_inventory
#
# MIGRATOR_DATABASE_URL authenticates as a role with CREATEROLE + ownership of the target
# database (docker-compose.dev.yml's POSTGRES_USER in local/dev) and is used only by
# `pnpm --filter @saas-inventory/api db:generate` / `db:migrate` — never by the running API
# process. Migration 0000 creates the app_migrator/app_tenant/app_platform/app_event_processor/
# app_public_resolver roles and switches to app_migrator for everything after, so every table
# ends up owned by app_migrator, not this bootstrap login.
MIGRATOR_DATABASE_URL=postgresql://postgres:password@localhost:5432/saas_inventory
#
# Login password for the app_tenant role, set by
# `pnpm --filter @saas-inventory/api db:bootstrap-dev-roles` (dev/local convenience — never set
# by a migration file, see that script and database/migrations/README.md).
APP_TENANT_PASSWORD=
#
# APP_PLATFORM_DATABASE_URL authenticates as the app_platform role (BYPASSRLS) — used by the
# running API only for the narrow, explicit administrative operations documented in
# apps/api/src/database/platform-client.ts (Prompt 04: creating the `tenants` row itself during
# self-service registration, and resolving a refresh token's tenant by its globally-unique hash).
# Never used as a general substitute for DATABASE_URL.
APP_PLATFORM_DATABASE_URL=postgresql://app_platform:password@localhost:5432/saas_inventory
#
# Login password for the app_platform role — set by the same
# `db:bootstrap-dev-roles` step (APP_PLATFORM_PASSWORD is read there; see
# apps/api/src/database/bootstrap-dev-roles.ts).
APP_PLATFORM_PASSWORD=
#
# APP_PUBLIC_RESOLVER_DATABASE_URL authenticates as the app_public_resolver role (RLS, one narrow
# SELECT policy per table) — used only by the QR public resolver (GET /q/:code, Prompt 09,
# apps/api/src/database/public-resolver-client.ts). No app.tenant_id is ever SET LOCAL on this
# connection — access is bounded entirely by the *_public_resolve RLS policies and column-level
# GRANTs on qr_codes/products/product_variants/locations (migrations 0003/0004/0018), not by a
# tenant filter, since there is no authenticated session on this route.
APP_PUBLIC_RESOLVER_DATABASE_URL=postgresql://app_public_resolver:password@localhost:5432/saas_inventory
#
# Login password for the app_public_resolver role — set by the same `db:bootstrap-dev-roles` step
# (APP_PUBLIC_RESOLVER_PASSWORD is read there; see apps/api/src/database/bootstrap-dev-roles.ts).
APP_PUBLIC_RESOLVER_PASSWORD=

# --- QR (Prompt 09) ---
# Rate limiting for the unauthenticated public resolver (GET /q/:code), keyed by IP alone (no
# identifier to key on, unlike login) — see apps/api/src/qr/public/qr-public-throttler.guard.ts.
QR_PUBLIC_RATE_LIMIT_TTL_SECONDS=60
QR_PUBLIC_RATE_LIMIT_MAX=30

# --- Import / Excel onboarding (Prompt 10, ADR-0027/ADR-0029) ---
# APP_IMPORT_WORKER_DATABASE_URL authenticates as the app_import_worker role (RLS, one permissive
# policy each on import_jobs/import_job_rows, migration 0019) — used only by the separate Import
# Worker deployable (apps/api/src/import-worker/main.ts) to claim jobs across every tenant. Never
# used by the main API process. The worker switches to a normal, per-tenant DATABASE_URL-shaped
# connection (app_tenant) once a job is claimed, to perform the actual catalog/inventory writes.
APP_IMPORT_WORKER_DATABASE_URL=postgresql://app_import_worker:password@localhost:5432/saas_inventory
# Login password for the app_import_worker role — set by the same `db:bootstrap-dev-roles` step
# (APP_IMPORT_WORKER_PASSWORD is read there; see apps/api/src/database/bootstrap-dev-roles.ts).
APP_IMPORT_WORKER_PASSWORD=
# Rows at or below this count validate/commit synchronously within the HTTP request; above it,
# both phases run as a background job on the Import Worker (database.md#large-imports — an
# illustrative, tunable threshold, not a fixed business rule).
IMPORT_SYNC_ROW_THRESHOLD=500
# Rows per commit/validation transaction — database.md#committing's batch size.
IMPORT_BATCH_SIZE=500
# Upload limits — security.md#file-upload-security.
IMPORT_MAX_FILE_SIZE_BYTES=26214400
IMPORT_MAX_ROWS=100000
# How often (ms) the Import Worker polls import_jobs for claimable work.
IMPORT_WORKER_POLL_INTERVAL_MS=2000
# A job stuck in 'validating'/'importing' with no progress for longer than this (ms) is treated as
# abandoned by a crashed worker and becomes reclaimable by another instance
# (database.md#large-imports' "claimed-but-stale-for-too-long check").
IMPORT_WORKER_STALE_CLAIM_MS=600000

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Auth (Prompt 04 — docs/architecture/security.md#authentication, ADR-0030) ---
# Placeholders only. Generate strong random secrets per environment;
# never reuse a secret across environments.
JWT_SECRET=
# Not used to sign a JWT (refresh tokens are opaque, not JWTs) — used as an HMAC pepper when
# hashing them for storage. See apps/api/src/auth/tokens/refresh-token.service.ts.
JWT_REFRESH_SECRET=
# Access token lifetime (seconds). Short-lived by design (security.md).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (seconds). Default: 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000
# Argon2id cost parameters (security.md's preferred password hash) — tune per environment's
# available memory/CPU, never lowered below a modern-safe minimum in production.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Login/register rate limiting (security.md#rate-limiting-and-brute-force-protection) — max
# attempts per window, per IP+identifier. In-memory (single API instance) in this phase; see
# apps/api/src/auth/guards/auth-throttler.guard.ts.
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=5
# Optional — cookie Domain attribute for session cookies. Leave blank for a host-only cookie
# (correct for local development and for a single-domain deployment).
COOKIE_DOMAIN=

# --- Administration (FASE 11, ADR-0032) ---
# Only read by `pnpm --filter @saas-inventory/database seed:platform-admin` (database/seeds/
# platform-admin.ts) — never by the running API process. Not required for normal operation; set
# these only when bootstrapping the first SuperAdmin account in a new environment.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FULL_NAME=

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- n8n integration ---
# The backend talks only to n8n via webhook; it never talks to Telegram
# directly and never stores a Telegram token. n8n owns the Telegram
# integration entirely.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
