# -----------------------------------------------------------------------------
# Environment variables template.
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# -----------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database ---
# PostgreSQL connection string used by the API only.
# The web/mobile apps never receive or use this variable.
DATABASE_URL=postgresql://user:password@localhost:5432/saas_inventory

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Placeholders only. Generate strong random secrets per environment;
# never reuse a secret across environments.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- n8n integration ---
# The backend talks only to n8n via webhook; it never talks to Telegram
# directly and never stores a Telegram token. n8n owns the Telegram
# integration entirely.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
