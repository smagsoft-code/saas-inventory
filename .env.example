# -----------------------------------------------------------------------------
# Environment variables template.
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# -----------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database ---
# PostgreSQL connection strings used by the API only.
# The web/mobile apps never receive or use these variables.
#
# DATABASE_URL authenticates as the app_tenant role — subject to Row-Level Security, used for
# all normal request handling (see docs/architecture/database.md#row-level-security).
DATABASE_URL=postgresql://app_tenant:password@localhost:5432/saas_inventory
#
# MIGRATOR_DATABASE_URL authenticates as a role with CREATEROLE + ownership of the target
# database (docker-compose.dev.yml's POSTGRES_USER in local/dev) and is used only by
# `pnpm --filter @saas-inventory/api db:generate` / `db:migrate` — never by the running API
# process. Migration 0000 creates the app_migrator/app_tenant/app_platform/app_event_processor/
# app_public_resolver roles and switches to app_migrator for everything after, so every table
# ends up owned by app_migrator, not this bootstrap login.
MIGRATOR_DATABASE_URL=postgresql://postgres:password@localhost:5432/saas_inventory
#
# Login password for the app_tenant role, set by
# `pnpm --filter @saas-inventory/api db:bootstrap-dev-roles` (dev/local convenience — never set
# by a migration file, see that script and database/migrations/README.md).
APP_TENANT_PASSWORD=

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Placeholders only. Generate strong random secrets per environment;
# never reuse a secret across environments.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- n8n integration ---
# The backend talks only to n8n via webhook; it never talks to Telegram
# directly and never stores a Telegram token. n8n owns the Telegram
# integration entirely.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
