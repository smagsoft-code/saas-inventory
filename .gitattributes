# Migration SQL must be byte-identical on every checkout: Drizzle hashes the file text (ADR-0041).
# The repository history is not rewritten; this only governs how git writes these files from now on.
database/migrations/** text eol=lf

# Git hooks are run by sh: keep LF so the shebang line works on every checkout (B4.11.5.7).
.githooks/* text eol=lf
