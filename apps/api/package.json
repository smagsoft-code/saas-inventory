{
  "name": "@saas-inventory/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:bootstrap-dev-roles": "tsx src/database/bootstrap-dev-roles.ts",
    "db:seed": "pnpm --filter @saas-inventory/database seed",
    "db:reset-demo": "pnpm --filter @saas-inventory/database reset-demo"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "^7.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@saas-inventory/config": "workspace:*",
    "@saas-inventory/shared": "workspace:*",
    "@saas-inventory/types": "workspace:*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@saas-inventory/eslint-config": "workspace:*",
    "@saas-inventory/tsconfig": "workspace:*",
    "@swc/core": "^1.16.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0"
  }
}
