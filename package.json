{
  "name": "saas-inventory",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant inventory management SaaS (monorepo root)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "secret-scan": "node tools/secret-scan/cli.mjs --mode working-tree",
    "secret-scan:staged": "node tools/secret-scan/cli.mjs --mode staged",
    "test:secret-scan": "node --test --test-reporter=spec tools/secret-scan/secret-scan.test.mjs tools/secret-scan/repo.test.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0"
  }
}
